# Set privately in Render. Never commit real credentials.
DATABASE_URL=
# Set a scrypt hash using the management setup script, not a plain password.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3199
# Development only: opt in to an isolated local PostgreSQL-compatible test store.
# Never enabled by production code; real deployment must use its own Neon database.
MARVEL_LOCAL_DB=false
